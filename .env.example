# Copy to .env.local for Next.js and Prisma CLI. Never commit real keys.
DATABASE_URL="postgresql://fleetora:fleetora_local@127.0.0.1:55432/fleetora"
# For Neon, use its non-pooled "Direct connection" URL here when running Prisma migrations.
# Leave empty for local development.
DIRECT_URL=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"
# Use an absolute persistent private directory in production. Never public/.
PRIVATE_STORAGE_PATH=".data/uploads"
