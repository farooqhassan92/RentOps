{
  "name": "rentops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs",
    "billing:run": "tsx scripts/billing.ts",
    "format": "prettier --write \"src/app/**/*.tsx\" \"src/components/**/*.tsx\" src/app/globals.css",
    "format:check": "prettier --check \"src/app/**/*.tsx\" \"src/components/**/*.tsx\" src/app/globals.css"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.17",
    "@fontsource/noto-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.0",
    "geist": "1.8.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "17.6.0-beta.15",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
